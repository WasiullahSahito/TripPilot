{
  "name": "travelplatform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "build": "tsc && vite build && node scripts/build-api.mjs",
    "build:api": "node scripts/build-api.mjs",
    "test": "vitest run",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "icons:extension": "node scripts/make-extension-icons.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "seed:admin": "tsx --env-file-if-exists=.env server/src/seed-admin.ts",
    "retention:run": "tsx --env-file-if-exists=.env server/src/run-retention.ts",
    "check:links": "tsx scripts/check-official-links.ts",
    "db:check": "tsx --env-file-if-exists=.env server/src/db-check.ts",
    "start:server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
