{
  "manifest_version": 3,
  "name": "TripPilot Browser Assistant",
  "version": "0.1.0",
  "description": "Helps you copy details you approve from TripPilot into a visa form. It never submits, solves CAPTCHAs or touches passwords or payments.",
  "minimum_chrome_version": "110",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TripPilot assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
