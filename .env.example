# Frontend (public values only — never put secrets in VITE_* variables)
VITE_API_BASE_URL=   # leave empty: same-origin /api (Vite proxy in dev, rewrites on Vercel)

# Server (never exposed to the browser)
JWT_SECRET=                      # required in production: openssl rand -hex 32
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
ADMIN_EMAIL=                     # the account registered with this email gets the admin role
DATA_FILE=server/.data/db.json   # dev JSON store; replace with PostgreSQL for production
DATA_KEY=                        # required in production: openssl rand -hex 32 (encrypts visa application data)
UPLOAD_DIR=server/.data/uploads

# --- Hosting & data (Vercel + Supabase) ---------------------------------------------------
SUPABASE_URL=                    # https://<project>.supabase.co  (server only)
SUPABASE_SERVICE_ROLE_KEY=       # SECRET. Server only. Never expose in a VITE_ variable.
STORAGE_MODE=                   # set to 'local' to ignore Supabase and use local files (development only)
SUPABASE_BUCKET=documents        # must be a PRIVATE bucket (see server/migrations/002_remaining_tables.sql)

# --- Optional integrations ----------------------------------------------------------------
LIBRETRANSLATE_URL=http://localhost:5000 # self-hosted LibreTranslate (see docker-compose.translate.yml)
OVERPASS_URL=                    # optional: your own Overpass server for the hotel directory (default: public server, light use only)
TRAVELPAYOUTS_TOKEN=             # free token: cached cheapest fares (Aviasales/WayAway network)
TRAVELPAYOUTS_MARKER=            # your public Travelpayouts partner id

# Frontend (public values only)
VITE_OCR_ASSET_BASE=/tesseract   # default: local files copied into public/tesseract during dev/build
# Tracked affiliate link templates from each partner's dashboard (placeholders: see src/features/affiliate/links.ts)
VITE_AFF_SKYSCANNER_URL=
VITE_AFF_WAYAWAY_URL=
VITE_AFF_AVIASALES_URL=
VITE_AFF_AGODA_URL=
VITE_AFF_BOOKING_URL=
VITE_AFF_STAY22_URL=
VITE_AFF_DISCOVERCARS_URL=
VITE_AFF_EKTA_URL=
VITE_AFF_VIATOR_URL=
VITE_AFF_GETYOURGUIDE_URL=
VITE_AFF_AIRALO_URL=
VITE_AFF_AIRHELP_URL=

# Stay22 affiliate id: shows a live-price hotel map on the Hotels page (https://www.stay22.com)
VITE_STAY22_AID=

# Upload scanning. Built-in checks always run (PDF active content, truncated or doctored images, decompression bombs).
# For real malware detection run ClamAV (clamd) yourself; it cannot run inside Vercel functions.
CLAMD_HOST=                      # e.g. localhost or your clamd server
CLAMD_PORT=3310
SCAN_FAIL_MODE=closed            # closed: refuse uploads if clamd is down (default). open: accept and log

# Scheduled deletion of files for users who opted in (Vercel Cron sends this as a Bearer token). Generate: openssl rand -hex 32
CRON_SECRET=

# --- Real booking + payment (all optional; without them the site keeps linking out to partners) ----------------
# Stripe: https://dashboard.stripe.com/apikeys (use sk_test_... first). Webhook endpoint: https://<your-domain>/api/commerce/webhook/stripe
# with events checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Safepay (customers living in Pakistan pay here; everyone else uses Stripe). Keys: Safepay merchant dashboard.
# Webhook URL: https://<your-domain>/api/commerce/webhook/safepay . SAFEPAY_ENV=sandbox until you have tested a payment.
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox
# Duffel (flights + Stays): https://duffel.com (use a duffel_test_... token first). Duffel bills your Duffel balance; keep it funded.
DUFFEL_ACCESS_TOKEN=
# Your fee on top of the provider price, in percent (0-20), shown to the customer before they pay.
SERVICE_FEE_PERCENT=0

# HelloSafe Atlas (insurance quotes; purchase happens on HelloSafe)
ATLAS_KEY_ID=
ATLAS_SIGNING_SECRET=
